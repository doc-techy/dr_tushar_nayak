# Optional overrides. The client IDs are already set in src/lib/seo.ts.
# Paste a measurement ID (G-XXXXXXXX) or the full GA4 snippet to replace the default.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Paste a container ID (GTM-XXXX) or the full Tag Manager snippet to replace the default.
NEXT_PUBLIC_GTM_ID=

# Paste the Google Search Console verification code, or the full meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Paste the Bing Webmaster verification code (msvalidate.01), or the full meta tag.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
